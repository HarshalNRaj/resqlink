{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run ResQlink frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"5174",
				"--strictPort"
			],
			"options": {
				"cwd": "${workspaceFolder}\\frontend"
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run ResQlink backend",
			"type": "shell",
			"command": "Set-Location C:\\abcd\\backend; & .\\.venv\\Scripts\\python.exe -m flask --app app run --host 127.0.0.1 --port 5000 --no-debugger --no-reload",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run ResQlink",
			"dependsOn": [
				"Run ResQlink frontend",
				"Run ResQlink backend"
			],
			"dependsOrder": "parallel",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run ResQlink frontend from subfolder",
			"type": "shell",
			"command": "npm --prefix C:\\abcd\\frontend run dev -- --host 127.0.0.1 --port 5173",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}